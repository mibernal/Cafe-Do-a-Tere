# --------------------------------------------------------------------------
# Supabase (base de datos y acceso administrativo)
# --------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
# Solo servidor. Nunca le pongas el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# --------------------------------------------------------------------------
# Wompi (pago en línea). Primero llaves de pruebas; luego producción.
# --------------------------------------------------------------------------
WOMPI_ENVIRONMENT=test
WOMPI_PUBLIC_KEY=pub_test_replace_me
WOMPI_PRIVATE_KEY=prv_test_replace_me
WOMPI_INTEGRITY_SECRET=test_integrity_replace_me
WOMPI_EVENTS_SECRET=test_events_replace_me

# --------------------------------------------------------------------------
# Pago contra entrega (además se habilita ciudad por ciudad en /admin)
# --------------------------------------------------------------------------
CASH_ON_DELIVERY_ENABLED=false
# Monto máximo de un pedido contra entrega, en pesos (incluye domicilio).
CASH_ON_DELIVERY_MAX_COP=300000

# --------------------------------------------------------------------------
# Tienda
# --------------------------------------------------------------------------
# Origen HTTPS exacto de la tienda (sin ruta). Wompi devuelve aquí al cliente.
NEXT_PUBLIC_SITE_URL=http://localhost:4173

# Los pedidos en línea siguen cerrados hasta confirmar precios, inventario,
# tarifas y textos legales. Mientras tanto la bolsa se envía por WhatsApp.
STORE_CHECKOUT_ENABLED=false
# Versión publicada de la política de datos (no puede contener "draft").
PRIVACY_POLICY_VERSION=draft

# Contacto público (se incrusta en el navegador al compilar).
NEXT_PUBLIC_WHATSAPP_NUMBER=573124193753
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Secreto aleatorio propio (32+ bytes) para las huellas del limitador de
# solicitudes. Si se omite se usa SUPABASE_SERVICE_ROLE_KEY.
# Genera uno con: openssl rand -base64 48
# RATE_LIMIT_SECRET=replace_with_a_random_secret
